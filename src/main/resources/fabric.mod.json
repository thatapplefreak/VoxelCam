{
	"schemaVersion": 1,
	"id": "voxelcam",
	"version": "${version}",
	"name": "VoxelCam",
	"description": "Adds features to make in-game screenshots easier to handle, including editing and uploading to image hosts.",
	"authors": [
		"thatapplefreak"
	],
	"contact": {
		"homepage": "https://github.com/thatapplefreak/VoxelCam"
	},
	"license": "LGPL-3.0-only",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.thatapplefreak.voxelcam.client.VoxelCamClient"
		],
		"modmenu": [
			"com.thatapplefreak.voxelcam.client.gui.VoxelCamModMenu"
		]
	},
	"mixins": [
		"voxelcam.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
